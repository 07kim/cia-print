# Epson Connect API 2.0 application credentials
EPSON_API_KEY=
EPSON_CLIENT_ID=
EPSON_CLIENT_SECRET=
EPSON_REDIRECT_URI=https://print-kappa-one.vercel.app/api/epson/callback

